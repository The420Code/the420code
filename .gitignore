node_modules/
.netlify/
.claude/

# Credentials — never commit. Copy .env.example to .env and fill in locally.
.env
.env.*
!.env.example
*.secret

# The Museum stages here. Out of the deploy until G says ship.
museum/build/out/
museum/__pycache__/

# The libraries' generators write their pages here before they are copied to /models/ and
# /five-doors/. Build output, never served, and it must not be walked as if it were the site.
tools/*/source/reader/site/

# Python's bytecode, from the site's own scripts. Never served.
__pycache__/

# The films are served from media.the420code.org and are never in the repo. Netlify publishes the
# whole repo, the two whole-chain films are over GitHub's 100 MB per-file limit, and one stray copy
# is a two-gigabyte repository.
*.mp4
*.mov
