# The 420 Code — credentials for automated deposits.
#
# Copy this file to .env, fill in the values, and load it into your shell
# (e.g. `set -a; . ./.env; set +a`) before running any script in scripts/.
#
# .env is gitignored. NEVER commit real values. NEVER write a token into a
# source file — every upload script reads its credential from the environment
# and refuses to run if the variable is missing.
#
# Rotate a token at the provider (not in git) if it is ever exposed.

# OSF (osf.io) — personal access token, narrowest scope
OSF_TOKEN=

# Internet Archive (archive.org) — S3 access key + secret
IA_ACCESS_KEY=
IA_SECRET_KEY=

# Figshare — personal token
FIGSHARE_TOKEN=

# Zenodo (zenodo.org) — personal access token, deposit scope
ZENODO_TOKEN=
